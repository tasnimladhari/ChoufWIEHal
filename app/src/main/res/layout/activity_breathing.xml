<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="24dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Breathe with me 💜" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/purple"/>
    <TextView android:id="@+id/timeLeft" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="2:00" android:textSize="16sp"/>
    <FrameLayout android:layout_width="260dp" android:layout_height="260dp" android:layout_marginTop="24dp" android:layout_marginBottom="24dp">
        <View android:id="@+id/circle" android:layout_width="150dp" android:layout_height="150dp" android:layout_gravity="center" android:background="@drawable/bg_circle"/>
    </FrameLayout>
    <TextView android:id="@+id/phase" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Get ready…" android:textSize="28sp" android:textStyle="bold"/>
    <Button android:id="@+id/btnGround" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:text="5-4-3-2-1 grounding"/>
    <Button android:id="@+id/btnClose" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="I feel a bit better"/>
</LinearLayout>
