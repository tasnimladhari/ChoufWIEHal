<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Settings" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/purple"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Local AI (Ollama)" android:textStyle="bold"/>
        <EditText android:id="@+id/etHost" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Server, e.g. http://10.0.2.2:11434" android:inputType="textUri"/>
        <EditText android:id="@+id/etModel" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Model, e.g. llama3.2:3b" android:inputType="textNoSuggestions"/>
        <Button android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Save"/>
        <Button android:id="@+id/btnTest" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Test connection"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Mode &amp; data" android:textStyle="bold"/>
        <Button android:id="@+id/btnMode" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Switch mode"/>
        <Button android:id="@+id/btnDemo" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Load demo data (simulated)"/>
        <Button android:id="@+id/btnClear" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Erase my plan and check-ins"/>
        <Button android:id="@+id/btnLogout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Log out"/>
    </LinearLayout>
</ScrollView>
